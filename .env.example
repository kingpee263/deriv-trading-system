# Deriv API Configuration
# Default public testing App ID is 1089 (register your own at https://api.deriv.com)
DERIV_APP_ID=1089

# Optional: Add your Deriv Demo or Real API Token for live contract execution.
# Leave empty to use Paper Trading / Simulation mode with live Deriv market ticks.
DERIV_API_TOKEN=

# Default Symbol & Server Settings
DEFAULT_SYMBOL=R_100
HOST=127.0.0.1
PORT=8000
